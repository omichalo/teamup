{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/ensure-dev-server.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-dangerous-commands.sh",
        "matcher": "git push|firebase deploy|npm run deploy:|npm run functions:deploy"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/ensure-dev-server.sh",
        "matcher": "npm run (check|build|deploy|functions:deploy|deploy:)|git push|firebase deploy|lsof -ti:3000"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/ensure-dev-on-stop.sh"
      }
    ]
  }
}
