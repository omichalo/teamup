{
  "name": "teamup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "npm run lint && npm run check:file-sizes && npm run check:page-titles && npm run type-check && npm test -- --ci && npm run build",
    "check:dev": "npm run lint && npm run check:file-sizes && npm run check:page-titles && npm run type-check",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "check:page-titles": "node scripts/check-page-titles.mjs",
    "dev": "next dev",
    "dev:ensure": "bash scripts/ensure-dev-server.sh",
    "dev:no-turbo": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "deploy:firestore:prod": "firebase deploy --only firestore:rules,firestore:indexes --project sqyping-teamup",
    "deploy:firestore:dev": "firebase deploy --only firestore:rules,firestore:indexes --project sqyping-teamup-dev",
    "build:strict": "tsc --noEmit && next build",
    "type-check": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "functions:setup": "node scripts/setup-functions-config.js",
    "functions:build": "cd functions && npm run build",
    "functions:deploy": "node scripts/deploy-functions.js",
    "functions:deploy:prod": "node scripts/deploy-functions.js sqyping-teamup",
    "functions:deploy:dev": "node scripts/deploy-functions.js sqyping-teamup-dev",
    "functions:secrets:prod": "firebase functions:secrets:set ID_FFTT --project sqyping-teamup && firebase functions:secrets:set PWD_FFTT --project sqyping-teamup",
    "functions:emulator": "cd functions && npm run serve",
    "functions:test": "node scripts/test-functions-local.js",
    "functions:logs": "cd functions && npm run logs",
    "deploy:apphosting": "firebase deploy --only apphosting",
    "discord:register-command": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/register-discord-command.ts",
    "email:preview": "tsx scripts/preview-email-templates.ts",
    "smoke:web": "bash scripts/smoke-web.sh",
    "emulators:smoke": "bash scripts/emulators-smoke.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-date-pickers": "^9.1.0",
    "@omichalo/ffttapi-node": "^0.0.9",
    "@omichalo/sqyping-mui-theme": "^0.2.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "dayjs": "^1.11.20",
    "discord.js": "^14.27.0",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.2.1",
    "firebase-admin": "^14.5.0",
    "next": "^15.5.28",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "react": "19.1.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "sanitize-html": "^2.18.1",
    "swagger-ui-dist": "^5.34.0",
    "tweetnacl": "^1.0.3",
    "yup": "^1.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/xml2js": "^0.4.14",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "^0.34.0",
    "form-data": "^4.0.6",
    "undici": "^6.29.1",
    "uuid": "^11.1.1",
    "qs": "^6.16.0",
    "xml2js": "^0.5.0",
    "postcss": "^8.5.10",
    "@tootallnate/once": "^3.0.1",
    "websocket-driver": "^0.7.5",
    "proxy-addr": "^2.0.8",
    "@grpc/grpc-js": "^1.14.6",
    "braces": "^3.0.3",
    "tar": "^7.5.22",
    "ws": "^8.22.0",
    "protobufjs": "^7.6.6",
    "node-forge": "^1.4.0",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "fdir": {
      "picomatch": "4.0.4"
    },
    "jest-util": {
      "picomatch": "4.0.4"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "ajv": "^6.14.0",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  }
}
